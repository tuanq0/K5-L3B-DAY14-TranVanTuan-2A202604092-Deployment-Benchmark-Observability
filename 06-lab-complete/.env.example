# Copy thành .env rồi điền giá trị thật. File .env đã nằm trong .gitignore và .dockerignore.
# Không ghi secret thật vào file này.

# Server
PORT=8000
ENVIRONMENT=development

# Bảo vệ API — client phải gửi header X-API-Key trùng với giá trị này
AGENT_API_KEY=change-me

# Redis — dùng cho rate limit, cost guard và /ready
# (trong docker compose, agent dùng redis://redis:6379/0 từ file docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM tối đa mỗi API key mỗi ngày (USD)
DAILY_BUDGET_USD=1.0
